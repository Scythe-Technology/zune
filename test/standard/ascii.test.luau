--!strict
--!native
--!optimize 2
local ascii = zune.ascii

local testing = require("@zune/testing")

local describe = testing.describe
local expect = testing.expect
local test = testing.test

describe("ascii", function()
    test("eqlIgnoreCase", function()
        local a = buffer.fromstring("HeLlo")
        expect(ascii.eqlIgnoreCase(a, "hello")).toBeTruthy()
        expect(ascii.eqlIgnoreCase(a, buffer.fromstring("HELLO"))).toBeTruthy()
        expect(ascii.eqlIgnoreCase("A1B", "a1b")).toBeTruthy()
        expect(ascii.eqlIgnoreCase("", "")).toBeTruthy()
        expect(ascii.eqlIgnoreCase("hello", "hello!")).toBeFalsy()
        expect(ascii.eqlIgnoreCase("hello", "helro")).toBeFalsy()
        expect(ascii.eqlIgnoreCase("A_B", "a-b")).toBeFalsy()
        expect(ascii.eqlIgnoreCase("caf\xC3\xA9", "CAF\xC3\xA9")).toBeTruthy()
        expect(ascii.eqlIgnoreCase("\xC3\x89", "\xC3\xA9")).toBeFalsy()
        expect(function()
            ascii.eqlIgnoreCase(1 :: any, "a")
        end).toThrow("expected a buffer, string, or userdata")
    end)

    test("eqlIgnoreCaseSlice", function()
        local a = buffer.fromstring("xxHeLlo")
        local b = buffer.fromstring("HELLO!!")
        expect(ascii.eqlIgnoreCaseSlice(a, 2, b, 0)).toBeFalsy()
        expect(ascii.eqlIgnoreCaseSlice(a, 2, b, 0, 5)).toBeTruthy()
        for i = 1, 5 do
            expect(ascii.eqlIgnoreCaseSlice(a, 2, b, 0, i)).toBeTruthy()
        end
        expect(ascii.eqlIgnoreCaseSlice(a, 2, b, 1, 4)).toBeFalsy()
        expect(ascii.eqlIgnoreCaseSlice("ab", 2, "cd", 2)).toBeTruthy()
        expect(ascii.eqlIgnoreCaseSlice("ab", 0, "cd", 0, 0)).toBeTruthy()
        expect(ascii.eqlIgnoreCaseSlice("test", 0, "TEST", 0)).toBeTruthy()
        expect(function()
            ascii.eqlIgnoreCaseSlice(a, 3, b, 0, 5)
        end).toThrow("access out of bounds")
        expect(function()
            ascii.eqlIgnoreCaseSlice(a, 8, b, 0)
        end).toThrow("access out of bounds")
    end)

    test("startsWithIgnoreCase", function()
        local a = buffer.fromstring("Needle")
        expect(ascii.startsWithIgnoreCase(a, "ne")).toBeTruthy()
        expect(ascii.startsWithIgnoreCase(a, "N")).toBeTruthy()
        expect(ascii.startsWithIgnoreCase(a, "needle")).toBeTruthy()
        expect(ascii.startsWithIgnoreCase(a, "NEED")).toBeTruthy()
        expect(ascii.startsWithIgnoreCase(a, "eedle")).toBeFalsy()
        expect(ascii.startsWithIgnoreCase(a, "needle!")).toBeFalsy()
        expect(ascii.startsWithIgnoreCase(a, "")).toBeTruthy()
        expect(ascii.startsWithIgnoreCase("", "")).toBeTruthy()
        expect(ascii.startsWithIgnoreCase("", "a")).toBeFalsy()
    end)

    test("endsWithIgnoreCase", function()
        local a = buffer.fromstring("HaYsTaCk")
        expect(ascii.endsWithIgnoreCase(a, "STACK")).toBeTruthy()
        expect(ascii.endsWithIgnoreCase(a, "k")).toBeTruthy()
        expect(ascii.endsWithIgnoreCase(a, "haystack")).toBeTruthy()
        expect(ascii.endsWithIgnoreCase(a, "STACK!")).toBeFalsy()
        expect(ascii.endsWithIgnoreCase(a, "hay")).toBeFalsy()
        expect(ascii.endsWithIgnoreCase(a, "")).toBeTruthy()
        expect(ascii.endsWithIgnoreCase("", "")).toBeTruthy()
        expect(ascii.endsWithIgnoreCase("BoB", "Bo")).toBeFalsy()
    end)

    test("findIgnoreCase", function()
        local a = buffer.fromstring("one Two Three Four")
        expect(ascii.findIgnoreCase(a, "foUr")).toBe(14)
        expect(ascii.findIgnoreCase(a, "t")).toBe(4)
        expect(ascii.findIgnoreCase(a, "TWO")).toBe(4)
        expect(ascii.findIgnoreCase(a, "one Two Three Four")).toBe(0)
        expect(ascii.findIgnoreCase("FOO foo", "fOo")).toBe(0)
        expect(ascii.findIgnoreCase(a, "gOur")).toBeNil()
        expect(ascii.findIgnoreCase(a, "fool")).toBeNil()
        expect(ascii.findIgnoreCase(a, "")).toBe(0)
        expect(ascii.findIgnoreCase("", "")).toBe(0)
        expect(ascii.findIgnoreCase("", "a")).toBeNil()

        local long = "one two three four five six seven eight nine ten eleven"
        expect(ascii.findIgnoreCase(long, "ThReE fOUr")).toBe(8)
        expect(ascii.findIgnoreCase(long, "ELEVEN")).toBe(49)
        expect(ascii.findIgnoreCase(long, "Two tWo")).toBeNil()
    end)

    test("findIgnoreCasePos", function()
        local a = buffer.fromstring("AbCxxaBc")
        expect(ascii.findIgnoreCasePos(a, 0, "abc")).toBe(0)
        expect(ascii.findIgnoreCasePos(a, 1, "abc")).toBe(5)
        expect(ascii.findIgnoreCasePos(a, 6, "abc")).toBeNil()
        expect(ascii.findIgnoreCasePos(a, 8, "")).toBe(8)
        expect(ascii.findIgnoreCasePos(a, 8, "a")).toBeNil()
        expect(ascii.findIgnoreCasePos("test", 1, "te")).toBeNil()
        expect(ascii.findIgnoreCasePos("test", 1, "T")).toBe(3)
        expect(function()
            ascii.findIgnoreCasePos(a, 9, "a")
        end).toThrow("access out of bounds")

        local long = "one two three four five six seven eight nine ten eleven"
        expect(ascii.findIgnoreCasePos(long, 8, "THREE")).toBe(8)
        expect(ascii.findIgnoreCasePos(long, 9, "ThReE fOUr")).toBeNil()
        expect(ascii.findIgnoreCasePos(long, 49, "eleven")).toBe(49)
        expect(ascii.findIgnoreCasePos(long, 50, "eleven")).toBeNil()
        expect(ascii.findIgnoreCasePos(long, 55, "")).toBe(55)
        expect(ascii.findIgnoreCasePos(a, 1, "abc", 7)).toBe(5)
        expect(ascii.findIgnoreCasePos(a, 1, "abc", 6)).toBeNil()
        expect(ascii.findIgnoreCasePos(a, 0, "ABC", 3)).toBe(0)
        expect(ascii.findIgnoreCasePos(a, 0, "ABC", 2)).toBeNil()
        expect(ascii.findIgnoreCasePos(a, 5, "AbC", 3)).toBe(5)
        expect(ascii.findIgnoreCasePos(a, 8, "", 0)).toBe(8)
        expect(ascii.findIgnoreCasePos(long, 0, "ThReE fOUr", 8)).toBeNil()
        expect(ascii.findIgnoreCasePos(long, 0, "ThReE fOUr", 18)).toBe(8)
        expect(ascii.findIgnoreCasePos(long, 8, "THREE", 5)).toBe(8)
        expect(ascii.findIgnoreCasePos(long, 8, "THREE", 4)).toBeNil()
        expect(ascii.findIgnoreCasePos(long, 49, "eleven", 6)).toBe(49)
        expect(ascii.findIgnoreCasePos(long, 49, "eleven", 5)).toBeNil()
        expect(function()
            ascii.findIgnoreCasePos(a, 5, "abc", 4)
        end).toThrow("access out of bounds")
    end)

    test("lessThanIgnoreCase", function()
        expect(ascii.lessThanIgnoreCase("abc", "ABD")).toBeTruthy()
        expect(ascii.lessThanIgnoreCase("ab", "ABC")).toBeTruthy()
        expect(ascii.lessThanIgnoreCase("", "a")).toBeTruthy()
        expect(ascii.lessThanIgnoreCase("ABC", "abc")).toBeFalsy()
        expect(ascii.lessThanIgnoreCase("abc", "ABC")).toBeFalsy()
        expect(ascii.lessThanIgnoreCase("abc", "AB")).toBeFalsy()
        expect(ascii.lessThanIgnoreCase("b", "A")).toBeFalsy()
        expect(ascii.lessThanIgnoreCase("", "")).toBeFalsy()
        expect(ascii.lessThanIgnoreCase("a", "")).toBeFalsy()
        local same = buffer.fromstring("AbC")
        expect(ascii.lessThanIgnoreCase(same, same)).toBeFalsy()
        expect(ascii.lessThanIgnoreCase("\x80", "\x81")).toBeTruthy()
        expect(ascii.lessThanIgnoreCase("\x80", "\x80")).toBeFalsy()
    end)

    test("lessThanIgnoreCaseSlice", function()
        local a = buffer.fromstring("xxABCyy")
        local b = buffer.fromstring("abdXYZ")
        expect(ascii.lessThanIgnoreCaseSlice(a, 2, b, 0, 3)).toBeTruthy()
        expect(ascii.lessThanIgnoreCaseSlice(a, 2, "ABC", 0, 3)).toBeFalsy()
        expect(ascii.lessThanIgnoreCaseSlice(a, 2, b, 0, 2)).toBeFalsy()
        expect(ascii.lessThanIgnoreCaseSlice("ab", 0, "abc", 0)).toBeTruthy()
        expect(ascii.lessThanIgnoreCaseSlice("ab", 2, "xy", 2)).toBeFalsy()
        expect(ascii.lessThanIgnoreCaseSlice("ab", 2, "xy", 0)).toBeTruthy()
        expect(ascii.lessThanIgnoreCaseSlice("ab", 0, "cd", 0, 0)).toBeFalsy()
        expect(function()
            ascii.lessThanIgnoreCaseSlice(a, 5, b, 0, 3)
        end).toThrow("access out of bounds")
        expect(function()
            ascii.lessThanIgnoreCaseSlice(a, 8, b, 0)
        end).toThrow("access out of bounds")
    end)
end)
