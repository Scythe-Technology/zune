--!strict

local io = require("@zune/io")
local spec = require("@zune/spec")
local testing = require("@zune/testing")

local describe = testing.describe
local expect = testing.expect
local test = testing.test

describe("types", function()
    test("primitives", function()
        expect(spec.string(123)).toBe(false)
        expect(spec.string("abc")).toBe(true)
        expect(spec.string("")).toBe(true)
        expect(spec.table(123)).toBe(false)
        expect(spec.table({})).toBe(true)
        expect(spec.boolean(false)).toBe(true)
        expect(spec.boolean(0)).toBe(false)
        expect(spec.buffer(buffer.create(1))).toBe(true)
        expect(spec.vector(vector.create(1, 0, 0))).toBe(true)
        expect(spec.fn(function() end)).toBe(true)
        expect(spec.thread(coroutine.create(function() end))).toBe(true)
        expect(spec.none(nil)).toBe(true)
        expect(spec.none(false)).toBe(false)
        expect(spec.void()).toBe(true)
        expect(spec.void(nil)).toBe(false)
        expect(spec.negate(spec.none)(nil)).toBe(false)
        expect(spec.negate(spec.none)(0)).toBe(true)
        expect(spec.negate(spec.string)(123)).toBe(true)
        expect(spec.negate(spec.string)("abc")).toBe(false)
    end)

    test("numbers", function()
        local nan = 0 / 0
        expect(spec.number(1)).toBe(true)
        expect(spec.number(nan)).toBe(true)
        expect(spec.number(math.huge)).toBe(true)
        expect(spec.number("1")).toBe(false)
        expect(spec.finite(1)).toBe(true)
        expect(spec.finite(nan)).toBe(false)
        expect(spec.finite(math.huge)).toBe(false)
        expect(spec.finite(-math.huge)).toBe(false)
        expect(spec.nan(nan)).toBe(true)
        expect(spec.nan(math.huge)).toBe(false)
        expect(spec.nan(1)).toBe(false)
        expect(spec.infinite(math.huge)).toBe(true)
        expect(spec.infinite(-math.huge)).toBe(true)
        expect(spec.infinite(nan)).toBe(false)
        expect(spec.infinite(1)).toBe(false)
        expect(spec.negate(spec.finite)(nan)).toBe(true)
        expect(spec.negate(spec.finite)(math.huge)).toBe(true)
        expect(spec.negate(spec.finite)(-math.huge)).toBe(true)
        expect(spec.negate(spec.finite)(1)).toBe(false)
        expect(spec.negate(spec.finite)("nan")).toBe(false)
        expect(spec.integer(10)).toBe(true)
        expect(spec.integer(10.5)).toBe(false)
        expect(spec.integer(nan)).toBe(false)
        expect(spec.integer(math.huge)).toBe(true)
        expect(spec.strict(spec.integer)(10)).toBe(true)
        expect(spec.strict(spec.integer)(math.huge)).toBe(false)
        expect(spec.strict(spec.integer)(nan)).toBe(false)
        expect(spec.strict(spec.number)(1.5)).toBe(true)
        expect(spec.strict(spec.number)(math.huge)).toBe(false)
        expect(spec.minInteger(10)(10)).toBe(true)
        expect(spec.minInteger(10)(9)).toBe(false)
        expect(spec.minInteger(10)(10.5)).toBe(false)
        expect(spec.minInteger(10)(math.huge)).toBe(true)
        expect(spec.strict(spec.minInteger(10))(math.huge)).toBe(false)
        expect(spec.maxInteger(100)(100)).toBe(true)
        expect(spec.maxInteger(100)(101)).toBe(false)

        local span = spec.union(spec.minInteger(10), spec.maxInteger(100))
        expect(span(10)).toBe(true)
        expect(span(100)).toBe(true)
        expect(span(9)).toBe(false)
        expect(span(101)).toBe(false)
        expect(span(10.5)).toBe(false)
        expect(span(math.huge)).toBe(false)
        expect(spec.strict(span)(50)).toBe(true)
        expect(spec.strict(span)(nan)).toBe(false)

        local wide = spec.union(spec.minNumber(0), spec.maxNumber(1))
        expect(wide(0.5)).toBe(true)
        expect(wide(-0.1)).toBe(false)
        expect(wide(math.huge)).toBe(false)
        expect(wide(nan)).toBe(false)
        expect(spec.minNumber(0)(math.huge)).toBe(true)
        expect(spec.minNumber(0)(nan)).toBe(false)
        expect(spec.maxNumber(1)(nan)).toBe(false)
        expect(spec.strict(spec.minNumber(0))(math.huge)).toBe(false)
        expect(spec.negate(spec.negate(spec.finite))(1)).toBe(true)
        expect(spec.negate(spec.negate(spec.finite))(nan)).toBe(false)
        expect(spec.negate(spec.negate(spec.string))).toBe(spec.string)
        expect(spec.union(spec.minInteger(100), spec.maxInteger(10))(0)).toBe(true)
        expect(spec.union(spec.minInteger(100), spec.maxInteger(10))(50)).toBe(false)
        expect(function()
            spec.minInteger(1.5)
        end).toThrow("min must be an integer")
        expect(function()
            spec.maxNumber(0 / 0)
        end).toThrow("max must be a finite number")
    end)
end)

describe("shapes", function()
    test("struct", function()
        local named = spec.struct({
            field = spec.string,
        })
        expect(named(1)).toBe(false)
        expect(named({ field = "abc" })).toBe(true)
        expect(named({ field = 1 })).toBe(false)
        expect(named({})).toBe(false)
        expect(named({ field = "abc", extra = 1 })).toBe(true)

        local exact = spec.strict(named)
        expect(exact({ field = "abc" })).toBe(true)
        expect(exact({ field = "abc", extra = 1 })).toBe(false)
        expect(spec.strict(spec.struct())({})).toBe(true)
        expect(spec.strict(spec.struct())({ extra = 1 })).toBe(false)

        local map = spec.struct({
            [spec.number] = spec.boolean,
        })
        expect(map(1)).toBe(false)
        expect(map({ [1] = true, [2] = false })).toBe(true)
        expect(map({ [1] = "no" })).toBe(false)
        expect(map({ a = true })).toBe(true)
        expect(spec.strict(map)({ a = true })).toBe(false)
        expect(spec.strict(map)({ [1] = true })).toBe(true)

        local either = spec.union(spec.string, named)
        expect(either("abc")).toBe(true)
        expect(either({ field = "abc" })).toBe(true)
        expect(either(1)).toBe(false)
    end)

    test("array", function()
        local flags = spec.array(spec.boolean)
        expect(flags({ true, false })).toBe(true)
        expect(flags({ true, 1 })).toBe(false)
        expect(flags({ true, extra = 1 })).toBe(true)
        expect(flags(1)).toBe(false)

        local exact = spec.strict(flags)
        expect(exact({ true, false })).toBe(true)
        expect(exact({})).toBe(true)
        expect(exact({ true, extra = 1 })).toBe(false)
        expect(exact({ [1] = true, [3] = true })).toBe(false)

        local built = (spec.strict(spec.array) :: any)(spec.boolean)
        expect(built({ true, extra = 1 })).toBe(false)
        expect(built({ false })).toBe(true)
    end)

    test("optional and literal", function()
        local name = spec.optional(spec.string)
        expect(name(nil)).toBe(true)
        expect(name("abc")).toBe(true)
        expect(name(1)).toBe(false)
        expect(spec.literal(1)(1)).toBe(true)
        expect(spec.literal(1)(2)).toBe(false)
        expect(spec.literal("constant")("constant")).toBe(true)
        expect(spec.literal("constant")("other")).toBe(false)

        local row = { a = 1 }
        expect(spec.literal(row)(row)).toBe(true)
        expect(spec.literal(row)({ a = 1 })).toBe(false)

        local point = vector.create(1, 0, 0)
        expect(spec.literal(point)(vector.create(1, 0, 0))).toBe(true)
        expect(spec.literal(point)(vector.create(0, 1, 0))).toBe(false)
        expect(spec.match("^%a+$")("raylib")).toBe(true)
        expect(spec.match("^%a+$")("ray lib")).toBe(false)
        expect(spec.match("^%a+$")(1)).toBe(false)
    end)

    test("arguments", function()
        local pair = spec.vararg(spec.string, spec.number)
        expect(pair("abc", 1)).toBe(true)
        expect(pair("abc")).toBe(false)
        expect(pair("abc", 1, true)).toBe(false)
        expect(pair(1, "abc")).toBe(false)
        expect(spec.vararg()()).toBe(true)
        expect(spec.negate(spec.void)()).toBe(false)
        expect(spec.negate(spec.void)(nil)).toBe(true)
        expect(spec.assert(spec.string)("abc")).toBe(nil)
        expect(function()
            spec.assert(spec.literal(1))("test value")
        end).toThrow('expected literal 1, got "test value"')
        expect(spec.assert(spec.void)()).toBe(nil)
        expect(function()
            spec.assert(spec.void)(nil)
        end).toThrow("expected nothing, got nil")
        expect(function()
            spec.assert(spec.void)(nil, nil)
        end).toThrow("expected nothing")
        expect(function()
            spec.assert(spec.vararg(spec.string, spec.number))("abc")
        end).toThrow('expected string, number, got "abc"')
    end)

    test("parameters", function()
        local byte = spec.union(spec.minInteger(0), spec.maxInteger(255))
        local rgb = spec.params(spec.label("R", byte), spec.label("G", byte), spec.label("B", byte))
        expect(rgb(1, 2, 3)).toBe(true)

        local ok, reason = rgb(1, 2, 3)
        expect(ok).toBe(true)
        expect(reason).toBeNil()
        ok, reason = rgb(1, 1.5, 300)
        expect(ok).toBe(false)
        expect(reason).toBe("G: expected integer from 0 to 255, got 1.5")
        ok, reason = rgb(-1, 1.5, 300)
        expect(reason).toBe("R: expected integer from 0 to 255, got -1")
        ok, reason = rgb(1, 2, 300)
        expect(reason).toBe("B: expected integer from 0 to 255, got 300")
        ok, reason = rgb(1)
        expect(reason).toBe("expected R, G, B, got 1")
        ok, reason = rgb(1, 2, 3, 4)
        expect(reason).toBe("expected R, G, B")
        ok, reason = spec.params(spec.label("Code", byte))(256)
        expect(reason).toBe("Code: expected integer from 0 to 255, got 256")
        ok, reason = spec.label("R", byte)(4)
        expect(ok).toBe(true)
        expect(reason).toBeNil()
        ok, reason = spec.strict(spec.label("N", spec.number))(math.huge)
        expect(reason).toBe("N: expected finite number, got infinity")
        expect(spec.strict(spec.label("N", spec.number))(1)).toBe(true)
        expect(spec.negate(spec.label("R", spec.string))(1)).toBe(true)
        ok, reason = spec.negate(spec.label("R", spec.string))("abc")
        expect(reason).toBe('R: expected not string, got "abc"')
        expect(function()
            spec.params()
        end).toThrow("params expects labels")
        expect(function()
            spec.params(byte)
        end).toThrow("params expects labels")
        expect(function()
            spec.label("", byte)
        end).toThrow("label is required")
        expect(function()
            spec.label("R", 1 :: any)
        end).toThrow("label expects a spec")
    end)

    test("reason", function()
        local options = spec.reason(spec.table, "must be a table")
        expect(options({})).toBe(true)

        local ok, reason = options(1)
        expect(ok).toBe(false)
        expect(reason).toBe("must be a table")

        local shape = spec.strict(spec.struct({
            url = spec.optional(spec.reason(spec.string, "must be a string")),
            path = spec.optional(spec.reason(spec.string, "must be a string")),
            options = spec.optional(options),
        }))
        ok, reason = shape({ options = 1, url = "https://example.test", path = "deps/a" })
        expect(reason).toBe("options: must be a table")
        ok, reason = shape({ url = 1, path = "deps/a" })
        expect(reason).toBe("url: must be a string")

        local both = spec.intersection(
            shape,
            spec.reason(function(value: any): (boolean, string?)
                if value.url and value.path then
                    return false, nil
                end
                return true, nil
            end, "path and url cannot be set")
        )
        ok, reason = both({ url = 1, path = "deps/a" })
        expect(reason).toBe("url: must be a string")
        ok, reason = both({ url = "https://example.test", path = "deps/a" })
        expect(reason).toBe("path and url cannot be set")
        expect(both({ url = "https://example.test" })).toBe(true)
        expect(spec.negate(options)(1)).toBe(true)
        expect(spec.strict(spec.reason(spec.number, "must be finite"))(math.huge)).toBe(false)
        expect(function()
            spec.reason(spec.table, "")
        end).toThrow("reason is required")
        expect(function()
            spec.reason(1 :: any, "must be a table")
        end).toThrow("reason expects a spec")
    end)

    test("length and choice", function()
        local name = spec.intersection(spec.string, spec.minLength(1))
        expect(name("raylib")).toBe(true)
        expect(name("")).toBe(false)
        expect(name(1)).toBe(false)
        expect(spec.minLength(1)({ "a" })).toBe(true)
        expect(spec.minLength(1)({})).toBe(false)
        expect(spec.minLength(1)(buffer.create(1))).toBe(true)
        expect(spec.minLength(1)(buffer.create(0))).toBe(false)
        expect(spec.maxLength(2)("ab")).toBe(true)
        expect(spec.maxLength(2)("abc")).toBe(false)
        expect(spec.maxLength(0)("")).toBe(true)
        expect(spec.maxLength(0)({ a = 1 })).toBe(true)
        expect(spec.intersection(spec.minLength(1), spec.maxLength(3))("ab")).toBe(true)
        expect(spec.intersection(spec.minLength(1), spec.maxLength(3))("abcd")).toBe(false)
        expect(spec.intersection(spec.string, spec.minLength(1), spec.maxLength(3))("ab")).toBe(true)
        expect(spec.intersection(spec.number, spec.integer, spec.finite, spec.minInteger(1))(4)).toBe(true)
        expect(spec.intersection(spec.number, spec.integer, spec.finite, spec.minInteger(1))(math.huge)).toBe(false)
        expect(spec.union(spec.string, spec.boolean, spec.number)(true)).toBe(true)
        expect(spec.union(spec.string, spec.boolean, spec.number)(nil)).toBe(false)

        local mode = spec.oneOf("r", "w")
        expect(mode("r")).toBe(true)
        expect(mode("x")).toBe(false)
        expect(spec.oneOf(1, 2, 3)(2)).toBe(true)
        expect(spec.oneOf(nil)(nil)).toBe(true)

        local row = { a = 1 }
        expect(spec.oneOf(row, "other")(row)).toBe(true)
        expect(spec.oneOf(row, "other")({ a = 1 })).toBe(false)

        local point = vector.create(1, 0, 0)
        expect(spec.oneOf(point, 0)(vector.create(1, 0, 0))).toBe(true)
        expect(spec.strict(spec.intersection(spec.integer, spec.minInteger(1)))(math.huge)).toBe(false)
        expect(spec.strict(spec.intersection(spec.integer, spec.minInteger(1)))(4)).toBe(true)
        expect(spec.strict(spec.intersection(spec.integer, spec.minInteger(1)))(0)).toBe(false)
        expect(function()
            spec.minLength(-1)
        end).toThrow("min must be at least 0")
        expect(function()
            spec.intersection()
        end).toThrow("intersection expects specs")
        expect(function()
            spec.oneOf()
        end).toThrow("oneOf expects a value")
        expect(function()
            spec.assert(mode)("x")
        end).toThrow('expected one of r, w, got "x"')
    end)

    test("reasons", function()
        local ok, reason = spec.string("abc")
        expect(ok).toBe(true)
        expect(reason).toBeNil()
        ok, reason = spec.string(123)
        expect(ok).toBe(false)
        expect(reason).toBe("expected string, got 123")
        ok, reason = spec.number("abcdefghijklmnopqrstuvwxyz0123456789")
        expect(reason).toBe('expected number, got "abcdefghijklmnopqrstuvwxyz012345..."')
        local nan = 0 / 0
        ok, reason = spec.finite(nan)
        expect(reason).toBe("expected finite number, got nan")
        ok, reason = spec.finite(math.huge)
        expect(reason).toBe("expected finite number, got infinity")
        ok, reason = spec.finite(-math.huge)
        expect(reason).toBe("expected finite number, got -infinity")
        ok, reason = spec.minInteger(10)(3)
        expect(reason).toBe("expected integer >= 10, got 3")
        ok, reason = spec.struct({ field = spec.string })({ field = 1 })
        expect(reason).toBe("field: expected string, got 1")
        ok, reason = spec.strict(spec.struct({ field = spec.string }))({ field = "abc", extra = 1 })
        expect(reason).toBe("unexpected extra")
        ok, reason = spec.array(spec.boolean)({ true, 1 })
        expect(reason).toBe("2: expected boolean, got 1")
        ok, reason = spec.array(spec.boolean)(1)
        expect(reason).toBe("expected array of boolean, got 1")
        ok, reason = spec.intersection(spec.string, spec.minLength(1))(1)
        expect(reason).toBe("expected string, got 1")
        ok, reason = spec.intersection(spec.string, spec.minLength(1))("")
        expect(reason).toBe("expected length >= 1, got length 0")
        ok, reason = spec.union(spec.string, spec.boolean)(1)
        expect(reason).toBe("expected string or boolean, got 1")
        ok, reason = spec.negate(spec.string)("abc")
        expect(reason).toBe('expected not string, got "abc"')
        ok, reason = spec.vararg(spec.string, spec.number)("abc", "no")
        expect(reason).toBe('2: expected number, got "no"')
        ok, reason = spec.object("File")("File")
        expect(reason).toBe('expected File, got "File"')
    end)
end)

describe("objects", function()
    test("userdata", function()
        local dir = io.cwd()
        expect(spec.userdata(dir)).toBe(true)
        expect(spec.object("Dir")(dir)).toBe(true)
        expect(spec.object("File")(dir)).toBe(false)

        local file = dir:openFile("lib/std/spec.luau", { mode = "r" })
        expect(spec.object("File")(file)).toBe(true)
        expect(spec.literal(file)(file)).toBe(true)
        expect(spec.literal(file)(dir)).toBe(false)

        file:close()

        expect(spec.object("Datetime")(zune.time.date.now())).toBe(true)
        expect(spec.object("Regex")(zune.regex.create("a+"))).toBe(true)
        expect(spec.object("BufferArray")(zune.io.createBufferArray())).toBe(true)
        expect(spec.object("CryptoHasher")(zune.crypto.createHash("blake3"))).toBe(true)
        expect(spec.object("File")("File")).toBe(false)
    end)
end)

return nil
