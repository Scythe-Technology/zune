--!strict

local text = require("@zune/text")
local testing = require("@zune/testing")

local describe = testing.describe
local expect = testing.expect
local test = testing.test

describe("bytes", function()
    test("basic", function()
        expect(text.bytes(0)).toBe("0 B")
        expect(text.bytes(1023)).toBe("1023 B")
        expect(text.bytes(1024)).toBe("1 KiB")
        expect(text.bytes(1536)).toBe("1.5 KiB")
        expect(text.bytes(10 * 1024)).toBe("10 KiB")
        expect(text.bytes(1024 * 1024)).toBe("1 MiB")
        expect(text.bytes(1.5 * 1024 * 1024)).toBe("1.5 MiB")
        expect(text.bytes(1024 * 1024 * 1024)).toBe("1 GiB")
        local tib = 1024 * 1024 * 1024 * 1024
        expect(text.bytes(tib)).toBe("1 TiB")
        expect(text.bytes(tib * 1.5)).toBe("1.5 TiB")
        expect(text.bytes(tib * 1024)).toBe("1 PiB")
        expect(text.bytes(tib * 1024 * 1024)).toBe("1 EiB")
        expect(text.bytes(tib * 1024 * 1024 * 1024)).toBe("1 ZiB")
        expect(text.bytes(tib * 1024 * 1024 * 1024 * 1024)).toBe("1 YiB")
        expect(text.bytes(tib * 1024 * 1024 * 1024 * 1024 * 1024)).toBe("1024 YiB")
    end)
end)

describe("time", function()
    test("basic", function()
        expect(text.time(0)).toBe("0s")
        expect(text.time(0.4)).toBe("0s")
        expect(text.time(0.5)).toBe("1s")
        expect(text.time(5)).toBe("5s")
        expect(text.time(59)).toBe("59s")
        expect(text.time(60)).toBe("1m00s")
        expect(text.time(65)).toBe("1m05s")
        expect(text.time(3599)).toBe("59m59s")
        expect(text.time(3600)).toBe("1h00m")
        expect(text.time(3661)).toBe("1h01m")
        expect(text.time(86400)).toBe("1d00h")
        expect(text.time(90000)).toBe("1d01h")
        expect(text.time(604800)).toBe("1w00d")
        expect(text.time(604800 * 10)).toBe("10w00d")
        expect(text.time(-5)).toBe("0s")
        expect(text.time(math.huge)).toBe("0s")
    end)
end)

describe("fit", function()
    test("basic", function()
        expect(text.fit("package", 10)).toBe("package")
        expect(text.fit("very-long-package-name", 10)).toBe("very-lo...")
        expect(text.fit("abcd", 4)).toBe("abcd")
        expect(text.fit("abcd", 3)).toBe("abc")
        expect(text.fit("abcd", 2)).toBe("ab")
        expect(text.fit("abcdef", 4)).toBe("a...")
        expect(function()
            text.fit("hello", 0)
        end).toThrow("width must be positive")
    end)
end)

describe("pad", function()
    test("basic", function()
        expect(text.pad("hi", 4)).toBe("hi  ")
        expect(text.pad("hi", 4, "left")).toBe("hi  ")
        expect(text.pad("hi", 4, "right")).toBe("  hi")
        expect(text.pad("hello", 3)).toBe("hello")
        expect(text.pad("hello", 5)).toBe("hello")
        expect(text.pad("", 2)).toBe("  ")
        expect(text.pad("a", 3.9)).toBe("a  ")
        expect(function()
            text.pad("hi", 0)
        end).toThrow("width must be positive")
    end)
end)

return nil
